/**
 * 预置大学课程库数据：6 门课程 / 51 个知识点 / 150+ 道题目
 * 纯数据定义，由 SeedService 写入本地数据库
 */
export class SeedQ {
  content: string;
  options: string[];
  answer: string;
  explanation: string;
  type: number;

  constructor(content: string, options: string[], answer: string, explanation: string, type: number) {
    this.content = content;
    this.options = options;
    this.answer = answer;
    this.explanation = explanation;
    this.type = type;
  }
}

export class SeedKp {
  name: string;
  description: string;
  questions: SeedQ[];

  constructor(name: string, description: string, questions: SeedQ[]) {
    this.name = name;
    this.description = description;
    this.questions = questions;
  }
}

export class SeedSubject {
  name: string;
  kps: SeedKp[];

  constructor(name: string, kps: SeedKp[]) {
    this.name = name;
    this.kps = kps;
  }
}

function q(content: string, options: string[], answer: string, explanation: string, type: number = 0): SeedQ {
  return new SeedQ(content, options, answer, explanation, type);
}

