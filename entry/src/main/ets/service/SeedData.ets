/** 按名称取知识点要点（供旧版知识点补全） */
export function kpDescription(name: string): string {
  const d = KP_DESCRIPTIONS.get(name);
  return d === undefined ? '' : d;
}

function kp(name: string, questions: SeedQ[]): SeedKp {
  const d = KP_DESCRIPTIONS.get(name);
  return new SeedKp(name, d === undefined ? '' : d, questions);
}

function sub(name: string, kps: SeedKp[]): SeedSubject {
  return new SeedSubject(name, kps);
}

